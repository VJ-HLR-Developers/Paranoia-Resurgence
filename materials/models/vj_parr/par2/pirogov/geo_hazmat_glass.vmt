"VertexLitGeneric"
{
    "$basetexture" "models/vj_parr/par2/pirogov/geo_hazmat_glass"
    //"$bumpmap" "models/vj_parr/par2/zombie/hazmat/geo_hazmat_glass_norm"

    "$phong" "0"
    "$phongalbedotint" "1"
    "$phongboost" ".1"
    "$phongfresnelranges" "[.3 .6 .9]"
    "$phongexponenttexture" "models/vj_parr/par2/zombie/hazmat/geo_hazmat_glass_gloss"

    //"$envmap" "env_cubemap"

    "$additive" "1"

    "$DEM_TintScale" "[1 1 1]"
    "$DEM_Multiplier" "1"
    "$DEM_ClampMin" "[0 0 0]"
    "$DEM_ClampMax" "[1 1 1]"
    "$DEM_Color" "[1 1 1]"

    "Proxies"
    {
        "DynamicEnvMap"
        {
            resultVar "$envmaptint"
        }
    }
}
