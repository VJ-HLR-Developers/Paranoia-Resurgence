"VertexLitGeneric"
{
    "$basetexture" "models/vj_parr/par2/weapons/pkm/PKMs"
    "$bumpmap" "models/vj_parr/par2/weapons/pkm/PKMs_norm"

    "$phong" "1"
    "$phongalbedotint" "1"
    "$phongboost" ".1"
    "$phongfresnelranges" "[.3 .6 .9]"
    "$phongexponenttexture" "models/vj_parr/par2/weapons/pkm/PKMs_gloss"

    "$envmap" "env_cubemap"
    "$normalmapalphaenvmapmask" "1"
    "$envmaptint" "[.05 .05 .05]"

    "$DEM_TintScale" "[.05 .05 .05]"
    "$DEM_Multiplier" "1"
    "$DEM_ClampMin" "[0 0 0]"
    "$DEM_ClampMax" "[1 1 1]"
    "$DEM_Color" "[1 1 1]"

    "Proxies"
    {
        "DynamicEnvMap"
        {
            resultVar "$envmaptint"
        }
    }
}

