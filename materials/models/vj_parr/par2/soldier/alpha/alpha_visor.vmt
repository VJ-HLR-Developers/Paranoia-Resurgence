"VertexLitGeneric"
{
    "$basetexture" "models/vj_parr/par2/soldier/alpha/alpha_visor"
    "$bumpmap" "models/vj_parr/par2/soldier/alpha/alpha_visor_norm"

    "$phong" "1"
    "$phongalbedotint" "1"
    "$phongboost" ".1"
    "$phongfresnelranges" "[.3 .6 .9]"
    "$phongexponenttexture" "models/vj_parr/par2/soldier/alpha/alpha_visor_gloss"

    "$envmap" "env_cubemap"
    "$normalmapalphaenvmapmask" "1"
    "$envmaptint" "[.5 .5 .5]"

    "$additive" "1"
    "$nocull" "1"

    "$DEM_TintScale" "[.5 .5 .5]"
    "$DEM_Multiplier" "1"
    "$DEM_ClampMin" "[0 0 0]"
    "$DEM_ClampMax" "[1 1 1]"
    "$DEM_Color" "[1 1 1]"

    "Proxies"
    {
        "DynamicEnvMap"
        {
            resultVar "$envmaptint"
        }
    }
}

